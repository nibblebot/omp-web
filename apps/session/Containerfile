# Session runtime image (P5.4): the containerized omp-session daemon for the
# kubernetes provider (apps/fleet/kubernetes-provider.ts).
#
# Build from the repo root (the COPY sources are context-relative):
#   docker build -f apps/session/Containerfile -t <image> .
# The same lockfile/build inputs the fleet host uses, so the image and the
# host runtime agree on dependency versions.
#
# Runtime contract (frozen, see apps/fleet/kubernetes-provider.ts and
# apps/fleet/workspace-lifecycle.ts):
#   - /workspace holds the per-workspace PVC volume. Layout matches the
#     fleet-local volume:
#     .omp-workspace-init.json, .checkout/, .home/.
#   - The daemon is started by entrypoint.sh, which execs the SAME runtime
#     entry the bwrap provider runs fleet-side (apps/session/index.ts) so
#     behavior matches across providers.
#   - No secret material is baked in: model/tool credentials arrive as
#     secretKeyRef env (profile.secretRefs) and the fleet callback
#     enrollment arrives as pod env from callback-env.json and is handed to
#     the daemon on stdin (--fleet-stdin). Kubernetes
#     credentials (service-account tokens) are not mounted.
#   - The container is unprivileged: read-only rootfs, no capabilities,
#     runAsUser 10001, /workspace + /tmp writable. The PVC is chowned to
#     10001 at first start (prep user), which requires a fsGroup-capable
#     StorageClass or an operator-owned hostPath chown.

# glibc base, not alpine: the pinned @oh-my-pi/pi-natives addon is linked
# against glibc (ld-linux-x86-64.so.2) and cannot load on musl. Bun 1.4: the
# SDK needs bun >= 1.3.14 (DisposableStack), matching the fleet host's runtime.
# --- deps stage: resolve the exact lockfile, no devDependencies -----------
FROM oven/bun:1.4-debian AS deps
WORKDIR /opt/omp-web
COPY package.json bun.lock ./
RUN bun install --frozen-lockfile --production && bun pm cache rm

# --- runtime stage: lean image with git + tini ----------------------------
FROM oven/bun:1.4-debian
RUN apt-get update \
 && apt-get install -y --no-install-recommends git ca-certificates tini \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/omp-web
COPY --from=deps /opt/omp-web/node_modules ./node_modules
# Session sources the daemon needs: root metadata for version lookup and #lib
# package imports, with the apps/ and closed lib/ directory layouts preserved.
# (fleet bwrap parity: the entry is apps/session/index.ts.)
COPY package.json ./
COPY apps/ ./apps/
COPY lib/ ./lib/

RUN groupadd --system --gid 10001 omp \
 && useradd --system --no-create-home --uid 10001 --gid omp --shell /usr/sbin/nologin omp \
 && mkdir -p /workspace /home/omp \
 && chown -R omp:omp /workspace /home/omp /opt/omp-web \
 && chmod 0555 /opt/omp-web/apps /opt/omp-web/apps/session

# Set after the RUN above: the restricted PATH omits /usr/sbin, where
# groupadd/useradd live. Isolated private home: populated at first start under the PVC.
ENV OMP_WORKSPACE_ROOT=/workspace \
    PATH=/usr/local/bin:/usr/bin:/bin \
    LANG=C.UTF-8

USER 10001:10001
ENTRYPOINT ["/usr/bin/tini", "--", "/opt/omp-web/apps/session/entrypoint.sh"]
