{
	"name": "omp-web",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "bun scripts/dev.ts",
		"dev:fleet": "bun scripts/dev.ts fleet",
		"dev:server": "bun --watch server/index.ts",
		"dev:web": "vite",
		"build": "vite build",
		"build:omp-session": "bun scripts/build-omp-session.ts",
		"start": "bun server/index.ts",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"test": "bun test --parallel --timeout 15000 --retry 0",
