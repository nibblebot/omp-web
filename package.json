		"marked": "^18.0.6",
		"solid-js": "^1.9.14"
	},
	"devDependencies": {
		"@types/bun": "^1.3.0",
		"@types/diff": "^8.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
