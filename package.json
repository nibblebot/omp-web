{
	"name": "omp-web",
	"private": true,
	"version": "0.2.1",
	"type": "module",
	"imports": {
		"#lib/*": "./lib/*.ts"
	},
	"bin": {
		"omp-web": "dist-bundle/cli.js"
	},
	"files": [
		"dist-bundle/"
	],
	"scripts": {
		"dev": "bun install && bun scripts/dev.ts fleet",
		"build": "bun scripts/build-omp-web.ts",
		"build:web": "vite build --config apps/web/vite.config.ts",
		"dev:docs": "astro dev --root docs",
		"build:docs": "astro build --root docs",
		"install:omp-web": "bun scripts/install-omp-web.ts",
		"check": "bun run check:types && bun run lint && bun run format:check && bun run build:web && bun run test",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "bun scripts/check-lib-boundary.ts && bun scripts/check-css-durations.ts && oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "bun scripts/test.ts",
		"test:isolated": "bun scripts/test.ts --isolated",
		"profile": "bun scripts/profile/index.ts",
		"design": "bun apps/design-system/server.ts stories",
		"demo": "bun apps/design-system/server.ts demo",
		"build:demo": "bun apps/design-system/build.ts"
	},
	"dependencies": {
		"@oh-my-pi/pi-agent-core": "18.14.0",
		"@oh-my-pi/pi-ai": "18.14.0",
		"@oh-my-pi/pi-catalog": "18.14.0",
		"@oh-my-pi/pi-coding-agent": "18.14.0",
		"@oh-my-pi/pi-tui": "18.14.0",
		"@oh-my-pi/pi-utils": "18.14.0",
		"@oh-my-pi/pi-wire": "18.14.0",
		"diff": "^9.0.0",
		"dompurify": "^3.4.17",
		"highlight.js": "^11.12.0",
		"marked": "^18.1.2",
		"solid-js": "^1.9.18"
	},
	"devDependencies": {
		"@astrojs/markdown-satteri": "^0.4.6",
		"@astrojs/starlight": "^0.42.8",
		"@babel/core": "^7.29.7",
		"@babel/parser": "^7.29.12",
		"@babel/preset-typescript": "^7",
		"@babel/types": "^7.29.11",
		"@types/bun": "^1.4.4",
		"@types/diff": "^8.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"astro": "^7.4.4",
		"babel-preset-solid": "^1.9.16",
		"enhanced-resolve": "^5.26.0",
		"eslint-plugin-solid": "^0.18.1",
		"oxfmt": "^0.75.0",
		"oxlint": "^1.90.0",
		"playwright-core": "1.64.1",
		"vite": "^8.3.5",
		"vite-plugin-solid": "^2.11.15"
	}
}
