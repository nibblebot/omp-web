{
	"name": "omp-web",
	"private": true,
	"version": "0.2.0",
	"type": "module",
	"bin": {
		"omp-web": "dist-bundle/cli.js"
	},
	"files": ["dist-bundle/"],
	"scripts": {
		"dev": "bun scripts/dev.ts fleet",
		"dev:server": "bun --watch server/index.ts",
		"dev:web": "vite",
		"build": "bun scripts/build-omp-web.ts",
		"build:web": "vite build",
		"dev:docs": "astro dev --root docs",
		"build:docs": "astro build --root docs",
		"preview:docs": "astro preview --root docs",
		"install:omp-web": "bun scripts/install-omp-web.ts",
		"start": "bun server/index.ts",
		"check:types": "tsgo -p tsconfig.json --noEmit",
		"lint": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"test": "bun scripts/test.ts",
		"bench": "bun scripts/bench-tests.ts",
		"tx-fixture": "bun scripts/gen-tx-fixture.ts",
		"collab": "bun server/collab-cli.ts",
		"fleet": "bun fleet/cli.ts"
	},
	"dependencies": {
		"@oh-my-pi/pi-agent-core": "18.2.6",
		"@oh-my-pi/pi-ai": "18.2.6",
		"@oh-my-pi/pi-catalog": "18.2.6",
		"@oh-my-pi/pi-coding-agent": "18.2.6",
		"@oh-my-pi/pi-tui": "18.2.6",
		"@oh-my-pi/pi-utils": "18.2.6",
		"@oh-my-pi/pi-wire": "18.2.6",
		"@tanstack/solid-virtual": "^3.13.37",
		"diff": "^9.0.0",
		"dompurify": "^3.4.14",
		"marked": "^18.0.11",
		"solid-js": "^1.9.15"
	},
	"devDependencies": {
		"@astrojs/markdown-satteri": "^0.4.1",
		"@astrojs/starlight": "^0.42.2",
		"@types/bun": "^1.4.0",
		"@types/diff": "^8.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"astro": "^7.3.3",
		"eslint-plugin-solid": "^0.15.0",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.81.0",
		"vite": "^8.2.2",
		"vite-plugin-solid": "^2.11.14"
	}
}
