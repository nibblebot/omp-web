		"fleet": "bun fleet/cli.ts"
	},
	"dependencies": {
		"@oh-my-pi/pi-agent-core": "17.1.8",
		"@oh-my-pi/pi-coding-agent": "17.1.8",
		"@oh-my-pi/pi-utils": "17.1.8",
		"diff": "^9.0.0",
		"dompurify": "^3.3.0",
		"marked": "^18.0.6",
		"solid-js": "^1.9.14"
	},
	"devDependencies": {
		"@types/bun": "^1.3.0",
		"@types/diff": "^8.0.0",
		"@typescript/native-preview": "7.0.0-dev.20260707.2",
		"vite": "^8.1.4",
		"vite-plugin-solid": "^2.11.12"
	}
